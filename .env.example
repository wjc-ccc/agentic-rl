# 复制为 .env 后填写；.env 已被 gitignore。
# 当前只有 SFT 执行；sft.paths 只读取 SFT_ 目录参数。

# 数据/模型/输出目录（放到 D 盘其他位置时指定绝对路径）
SFT_DATA_DIR=
SFT_MODELS_DIR=
SFT_OUTPUTS_DIR=

# SwanLab：用户选择 cloud；本地离线记录可改为 offline
SFT_SWANLAB_PROJECT=sft-rl-flow
SFT_SWANLAB_MODE=cloud
SWANLAB_API_KEY=

# RL 仅备用，没有训练入口或运行时环境覆盖；参数只在 configs/rl/ 独立保存。

# PyTRIO：可留空，改用 uv run trio login 的本地登录状态
# API Key 不写进 YAML、配置快照或 Git；模型在 configs/sft/ 中选择
PYTRIO_API_KEY=
