# 复制为 .env 后填写；.env 已被 gitignore。
# 这些变量都可由 rlflow.paths 读取，留空则用仓库内默认目录。

# 数据/模型/输出目录（放到 D 盘其他位置时指定绝对路径）
RLFLOW_DATA_DIR=
RLFLOW_MODELS_DIR=
RLFLOW_OUTPUTS_DIR=

# SwanLab：默认离线，只有主动上传时才需要 key
SWANLAB_PROJECT=sft-rl-flow
SWANLAB_MODE=offline
SWANLAB_API_KEY=

# PyTRIO：可留空，改用 uv run trio login 的本地登录状态
# API Key 不写进 YAML、配置快照或 Git；模型在 configs/sft/ 中选择
PYTRIO_API_KEY=
